# --- Amazon SP-API (Login with Amazon / LWA) ---
LWA_CLIENT_ID=HEHE
LWA_CLIENT_SECRET=HEHE
SP_API_APP_ID=HEHE
SP_API_REDIRECT_URI=http://localhost:4000/oauth/callback
# Used to build the Amazon OAuth redirect URL when SP_API_REDIRECT_URI is omitted.
# In production, set one of these to your public HTTPS API origin and register
# <origin>/oauth/callback as a Redirect URI in your Amazon SP-API app.
PUBLIC_API_ORIGIN=http://localhost:4000

# --- For local single-seller testing before multi-tenant OAuth is wired up ---
TEST_SELLER_REFRESH_TOKEN=HEHE
TEST_SELLER_ID=HEHE
TEST_MARKETPLACE_ID=A21TJRUUN4KGV

# --- Database (AWS RDS managed Postgres — real instance from the start) ---
DATABASE_URL=HEHE

# --- File storage (real AWS S3 from the start) ---
AWS_ACCESS_KEY_ID=HEHE
AWS_SECRET_ACCESS_KEY=HEHE
S3_BUCKET=HEHE
S3_REGION=ap-south-1

# --- App auth ---
JWT_SECRET=HEHE
SESSION_SECRET=HEHE
FRONTEND_ORIGIN=http://localhost:5173
API_URL=http://localhost:4000

# --- Order scheduling (merged in from the standalone order scheduling tool) ---
# ALL OF THESE ARE OPTIONAL. Order scheduling reuses the Amazon credentials,
# DATABASE_URL and SESSION_SECRET above - it deliberately does not introduce a
# second set of Amazon credentials for the same application and the same seller.
#
# Set ENCRYPTION_KEY *only* if you already ran the standalone scheduling tool
# and want its stored marketplace credentials to stay readable: it is that
# tool's own key, 32 bytes base64. Left unset, a key is derived from
# SESSION_SECRET and one secret covers everything. Setting the WRONG value here
# is worse than leaving it blank - stored credentials become undecryptable with
# no error until something tries to use them.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_VERSION=1
#
# Connections the scheduling pool may open, on top of the reconciliation pool's.
# SCHEDULING_POOL_MAX=5
#
# Send version=beta on the Amazon consent URL, required while the SP-API
# application is still a draft (unpublished).
# SP_API_DRAFT_APP=false
